#!/bin/sh
# Gives this checkout its own Bazel output base, inside the checkout unless a path is given, so
# deleting the worktree deletes its cache. Bazel does not expand %workspace% in --output_base, so
# the absolute path lives in a git-ignored .bazelrc.local that each checkout generates for itself.
# When BAZEL_SHARED_CACHE_DIR is set, every checkout also points its disk and repository caches
# at that directory and trims the disk cache to 12G / 7 days.
set -eu

root=$(git rev-parse --show-toplevel)
output_base=${1:-$root/.bazel-output}
shared=${BAZEL_SHARED_CACHE_DIR:-}

temporary=$(mktemp "$root/.bazelrc.local.XXXXXX")
{
    printf 'startup --output_base=%s\n' "$output_base"
    if [ -n "$shared" ]; then
        printf 'common --disk_cache=%s/disk-cache\n' "$shared"
        printf 'common --repository_cache=%s/repo-cache\n' "$shared"
        printf 'common --experimental_disk_cache_gc_max_size=12G\n'
        printf 'common --experimental_disk_cache_gc_max_age=7d\n'
    fi
} >"$temporary"
mv "$temporary" "$root/.bazelrc.local"

import='try-import %workspace%/.bazelrc.local'
grep -qxF "$import" "$root/.bazelrc" 2>/dev/null || printf '\n%s\n' "$import" >>"$root/.bazelrc"

for entry in /.bazel-output/ /.bazelrc.local /.bazelrc.local.* /.bazel-output-disk.log; do
    grep -qxF "$entry" "$root/.gitignore" 2>/dev/null || printf '%s\n' "$entry" >>"$root/.gitignore"
done

# The output base contains external/_main -> workspace. Keep Bazel's recursive package
# discovery out of it, independently of Git's ignores.
ignore="$root/.bazelignore"
if ! grep -qxF '.bazel-output' "$ignore" 2>/dev/null; then
    if [ -s "$ignore" ] && [ -n "$(tail -c 1 "$ignore")" ]; then
        printf '\n' >>"$ignore"
    fi
    printf '%s\n' '.bazel-output' >>"$ignore"
fi
